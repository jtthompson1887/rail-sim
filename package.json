{
  "name": "train-game",
  "version": "1.0.0",
  "description": "A train game",
  "main": "src/main.ts",
  "scripts": {
    "start": "webpack-dev-server --open --mode=development",
    "build": "webpack --mode production",
    "build:test-controls": "webpack --mode production --env testControls=true",
    "test": "jest --coverage",
    "test:e2e": "npx playwright test",
    "benchmark:construction-drag": "node tests/performance/run-construction-drag-browser.js",
    "benchmark:world-generation": "node tests/performance/run-world-generation-browser.js"
  },
  "keywords": [
    "train",
    "game"
  ],
  "author": "Jordan Thompson",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.0.0",
    "babel-loader": "^8.0.0",
    "file-loader": "^6.0.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "serve": "^14.2.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0",
    "webpack-dev-server": "^4.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.14.0",
    "@babylonjs/materials": "^9.14.0",
    "copy-webpack-plugin": "^11.0.0",
    "matter-js": "^0.19.0",
    "phaser": "^3.60.0"
  }
}
